generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ??? Enums ???????????????????????????????????????????????????????????????????

enum UserRole {
  platform_owner
  owner
  manager
  sales_rep
  cpa
  wholesale_dealer
}

enum DealershipStatus {
  pending
  active
  suspended
  canceled
  payment_failed
}

enum PlanSlug {
  wholesaler
  independent_dealer
  growing_dealership
}

enum RegistrationStatus {
  pending
  checkout_started
  active
  payment_failed
  canceled
}

enum PaymentStatus {
  pending
  on_time
  behind
}

enum VehicleStatus {
  in_stock
  needs_attention
  pending_deal
  sold
  loss
  wholesale
  out_of_state_sale
  arbitration
}

enum CustomerStatus {
  lead
  active_deal
  customer
}

enum CustomerType {
  individual
  dealer
  wholesale
}

enum LeadSource {
  website
  referral
  walk_in
  ads
  social_media
  other
}

enum DealJacketWorkflowStatus {
  draft
  pending_review
  changes_requested
  resubmitted
  approved
  rejected
}

enum DealType {
  Retail
  Wholesale
  Fleet
}

enum CommissionType {
  percentage
  manual
  flat
}

enum SalesRepCommissionType {
  percentage
  flat
}

enum CommissionStatus {
  pending_review
  approved
  rejected
  paid
}


enum PaymentMethodStatus {
  unpaid
  paid
  partial
}

enum FlooringRateType {
  monthly
  daily
  apr
}

enum TaxFilingFrequency {
  monthly
  quarterly
  annual
  custom
}

enum TaxPeriodStatus {
  open
  due
  paid
  filed
  closed
}

enum CpaNotePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CpaNoteStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum CalendarEventType {
  compliance
  appointment
  payroll
  follow_up
  task
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum PayrollRunStatus {
  draft
  processed
  paid
}

// ??? Platform / Onboarding ????????????????????????????????????????????????????

model Registration {
  id                       String             @id @default(uuid()) @db.Uuid
  name                     String
  email                    String             @unique
  phone                    String             @default("")
  dealershipName           String
  city                     String?
  zipCode                  String  @default("")
  state                    String
  plan                     PlanSlug?
  status                   RegistrationStatus @default(pending)
  paymentStatus            PaymentStatus      @default(pending)
  monthlyFee               Decimal            @default(99.99) @db.Decimal(12, 2)
  stripeCustomerId         String?
  stripeSubscriptionId     String?            @unique
  stripeCheckoutSessionId  String?
  completionTokenHash      String?
  completionTokenExpiresAt DateTime?
  emailSentAt              DateTime?
  welcomeEmailLockId       String?
  temporaryPasswordHash    String?
  temporaryPasswordSentAt  DateTime?
  dealershipId             String?            @db.Uuid
  dealership               Dealership?        @relation(fields: [dealershipId], references: [id])
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([state])
  @@index([zipCode])
  @@index([stripeCustomerId])
  @@index([stripeCheckoutSessionId])
  @@map("registrations")
}

model Dealership {
  id                   String           @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String           @unique
  email                String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  plan                 PlanSlug?
  status               DealershipStatus @default(pending)
  paymentStatus        PaymentStatus    @default(pending)
  monthlyFee           Decimal          @default(99.99) @db.Decimal(12, 2)
  stripeCustomerId     String?
  stripeSubscriptionId String?          @unique
  billingAutoExpense   Boolean          @default(false)
  billingNotifyBefore  Boolean          @default(true)
  billingReminderFor   DateTime?
  billingDueEmailFor   DateTime?
  cardBrand            String?
  cardLast4            String?          @db.VarChar(4)
  cardExpMonth         Int?
  cardExpYear          Int?
  currentPeriodEnd     DateTime?
  kpiColors            Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  registrations        Registration[]
  users                User[]
  invitations          Invitation[]
  vehicles             Vehicle[]
  customers            Customer[]
  deals                Deal[]
  dealJackets          DealJacket[]
  dealershipExpenses   DealershipExpense[]
  vehicleExpenses      VehicleExpense[]
  flooringPlans        FlooringPlan[]
  flooringUndoSnapshot FlooringUndoSnapshot?
  taxSettings          DealershipTaxSettings?
  taxFilingPeriods     TaxFilingPeriod[]
  salesRepProfiles     SalesRepProfile[]
  commissions          SalesRepCommission[]
  payrollRuns          PayrollRun[]
  staff                StaffMember[]
  cpaNotes             CpaNote[]
  calendarEvents       CalendarEvent[]
  calendarDayNotes     CalendarDayNote[]
  dashboardNotes       DashboardNote[]
  conversations        Conversation[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  files                FileObject[]
  vehicleStatusHistory VehicleStatusHistory[]
  pricingHistory       PricingHistory[]
  vehicleImages        VehicleImage[]
  billingPayments      BillingPayment[]
  supportMessages      SupportMessage[]

  @@index([status])
  @@index([state])
  @@index([stripeCustomerId])
  @@map("dealerships")
}

model BillingPayment {
  id                     String     @id @default(uuid()) @db.Uuid
  dealershipId           String     @db.Uuid
  dealership             Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  stripeInvoiceId        String     @unique
  stripePaymentIntentId  String?
  amount                 Decimal    @db.Decimal(12, 2)
  currency               String     @default("usd") @db.VarChar(10)
  status                 String     @db.VarChar(20)
  planSlug               String?    @db.VarChar(40)
  planLabel              String?    @db.VarChar(80)
  paidAt                 DateTime?
  periodStart            DateTime?
  periodEnd              DateTime?
  hostedInvoiceUrl       String?
  expenseId              String?    @db.Uuid
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([dealershipId, paidAt])
  @@map("billing_payments")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  username     String?
  passwordHash String
  fullName     String
  phone        String?
  imageUrl     String?
  role         UserRole
  isActive     Boolean   @default(true)
  dealershipId String?   @db.Uuid
  dealership   Dealership? @relation(fields: [dealershipId], references: [id])
  lastLoginAt  DateTime?
  mustResetPassword Boolean @default(false)
  isMainPlatformOwner Boolean @default(false)
   introCompleted   Boolean   @default(false)
   termsAccepted    Boolean   @default(false)
   termsVersion     String?
   termsPrintedName String?
   termsDealership  String?
   termsSignature   String?   @db.Text
   termsAcceptedAt  DateTime?
   termsIp          String?
   termsUserAgent   String?
   createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  invitationsSent      Invitation[]         @relation("InvitationInviter")
  salesRepProfile      SalesRepProfile?
  auditLogs            AuditLog[]
  notifications        Notification[]
  vehiclesCreated      Vehicle[]            @relation("VehicleCreatedBy")
  customersCreated     Customer[]           @relation("CustomerCreatedBy")
  customersAsRep       Customer[]           @relation("CustomerSalesRep")
  dealsAsRep           Deal[]               @relation("DealSalesRep")
  dealsCreated         Deal[]               @relation("DealCreatedBy")
  dealJacketsAsRep     DealJacket[]         @relation("JacketSalesRep")
  dealJacketsReviewed  DealJacket[]         @relation("JacketReviewedBy")
  dealJacketActivity   DealJacketActivity[]
  messagesSent         Message[]
  conversationsCreated Conversation[]   @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messageReads         MessageRead[]
  messageReactions     MessageReaction[]
  conversationSessions ConversationSession[]
  userPresence         UserPresence?
  typingStatus         TypingStatus[]
  notificationQueue    NotificationQueue[]
  calendarEventsCreated CalendarEvent[]
  cpaNotesCreated      CpaNote[]            @relation("CpaNoteCreatedBy")
  cpaNotesAssigned     CpaNote[]            @relation("CpaNoteAssignedTo")
  cpaNoteComments      CpaNoteComment[]
  filesUploaded        FileObject[]
  commissionsPaid      SalesRepCommission[] @relation("CommissionPaidBy")
  commissionsAsRep     SalesRepCommission[] @relation("CommissionSalesRep")
  supportMessages      SupportMessage[]

  @@unique([dealershipId, email])
  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  dealershipId String           @db.Uuid
  dealership   Dealership       @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  email        String
  role         UserRole
  fullName     String?
  tokenHash    String
  status       InvitationStatus @default(pending)
  sendCount    Int              @default(1)
  lastSentAt   DateTime         @default(now())
  invitedById  String?          @db.Uuid
  invitedBy    User?            @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([dealershipId])
  @@index([tokenHash])
  @@index([email])
  @@map("invitations")
}

// ??? Vehicles ?????????????????????????????????????????????????????????????????

model Vehicle {
  id                    String        @id @default(uuid()) @db.Uuid
  dealershipId          String        @db.Uuid
  dealership            Dealership    @relation(fields: [dealershipId], references: [id])
  vin                   String
  stockNumber           String?
  make                  String
  model                 String
  trim                  String?
  year                  Int
  bodyStyle             String?
  exteriorColor         String?
  interiorColor         String?
  drivetrain            String?
  fuelType              String?
  engine                String?
  transmission          String?
  mileage               Int?
  doors                 Int?
  acquisitionDate       DateTime?     @db.Date
  acquisitionCost       Decimal?      @db.Decimal(12, 2)
  askingPrice           Decimal?      @db.Decimal(12, 2)
  marketValue           Decimal?      @db.Decimal(12, 2)
  wholesalePrice        Decimal?      @db.Decimal(12, 2)
  reconditioningCost    Decimal       @default(0) @db.Decimal(12, 2)
  totalInvested         Decimal       @default(0) @db.Decimal(12, 2)
  registrationFees      Decimal       @default(0) @db.Decimal(12, 2)
  auctionFees           Decimal       @default(0) @db.Decimal(12, 2)
  flooringFees          Decimal       @default(0) @db.Decimal(12, 2)
  titleStatus           String?
  licensePlate          String?
  state                 String?
  sellerAuction         String?
  purchaseType          String?
  notes                 String?
  titleReceived         Boolean       @default(true)
  soldAt                DateTime?
  soldPrice             Decimal?      @db.Decimal(12, 2)
  flooringStartDate     DateTime?     @db.Date
  flooringPlanId        String?       @db.Uuid
  flooringPlan          FlooringPlan? @relation(fields: [flooringPlanId], references: [id])
  status                VehicleStatus @default(in_stock)
  isWholesale           Boolean       @default(false)
  auctionHouse          String?
  auctionDate           DateTime?     @db.Date
  auctionRuns           Int           @default(0)
  saleChannel           String?       // auction | dealer | other
  titlePresent          Boolean       @default(true)
  fees                  Json          @default("{}")
  additionalExpenses    Decimal       @default(0) @db.Decimal(12, 2)
  customerName          String?
  customerPhone         String?
  customerEmail         String?
  customerAddress       String?
  createdById           String?       @db.Uuid
  createdBy             User?         @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  images         VehicleImage[]
  statusHistory  VehicleStatusHistory[]
  pricingHistory PricingHistory[]
  expenses       VehicleExpense[]
  deal           Deal?
  dealJackets    DealJacket[]

  // Active VIN uniqueness is enforced by a partial unique index in SQL:
  // vehicles_dealershipId_vin_active_key ON (dealershipId, vin) WHERE deletedAt IS NULL
  // Soft-deleted rows keep their VIN so history remains intact and the VIN can be reused.
  @@index([dealershipId, vin])
  @@index([dealershipId, status, deletedAt])
  @@index([dealershipId, stockNumber])
  @@index([dealershipId, soldAt])
  @@map("vehicles")
}

model VehicleImage {
  id           String     @id @default(uuid()) @db.Uuid
  vehicleId    String     @db.Uuid
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealershipId String     @db.Uuid
  dealership   Dealership @relation(fields: [dealershipId], references: [id])
  storagePath  String
  url          String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleStatusHistory {
  id           String         @id @default(uuid()) @db.Uuid
  vehicleId    String         @db.Uuid
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealershipId String         @db.Uuid
  dealership   Dealership     @relation(fields: [dealershipId], references: [id])
  fromStatus   VehicleStatus?
  toStatus     VehicleStatus
  note         String?
  changedById  String?        @db.Uuid
  createdAt    DateTime       @default(now())

  @@index([vehicleId, createdAt])
  @@map("vehicle_status_history")
}

model PricingHistory {
  id           String     @id @default(uuid()) @db.Uuid
  vehicleId    String     @db.Uuid
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealershipId String     @db.Uuid
  dealership   Dealership @relation(fields: [dealershipId], references: [id])
  askingPrice  Decimal?   @db.Decimal(12, 2)
  marketValue  Decimal?   @db.Decimal(12, 2)
  note         String?
  changedById  String?    @db.Uuid
  createdAt    DateTime   @default(now())

  @@index([vehicleId, createdAt])
  @@map("pricing_history")
}

model VehicleExpense {
  id                String              @id @default(uuid()) @db.Uuid
  vehicleId         String              @db.Uuid
  vehicle           Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealershipId      String              @db.Uuid
  dealership        Dealership          @relation(fields: [dealershipId], references: [id])
  repairDate        DateTime            @db.Date
  category          String              @default("repair")
  repairType        String?
  description       String
  expenseName       String?
  shopVendor        String?
  paymentMethod     String?
  invoiceNumber     String?
  notes             String?
  receiptStoragePath String?
  laborCost         Decimal             @default(0) @db.Decimal(12, 2)
  partsCost         Decimal             @default(0) @db.Decimal(12, 2)
  otherFees         Decimal             @default(0) @db.Decimal(12, 2)
  totalCost         Decimal             @db.Decimal(12, 2)
  isInternal        Boolean             @default(false)
  paymentStatus     PaymentMethodStatus @default(unpaid)
  datePaid          DateTime?           @db.Date
  createdById       String?             @db.Uuid
  createdAt         DateTime            @default(now())
  deletedAt         DateTime?

  @@index([dealershipId, vehicleId])
  @@map("vehicle_expenses")
}

model FlooringPlan {
  id                   String           @id @default(uuid()) @db.Uuid
  dealershipId         String           @db.Uuid
  dealership           Dealership       @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  name                 String           @default("Standard Floor Plan")
  rateType             FlooringRateType @default(monthly)
  baseRate             Decimal          @db.Decimal(12, 4)
  effectiveDate        DateTime         @db.Date
  rateIncreaseEnabled  Boolean          @default(false)
  increaseAfterDays    Int?
  increaseAmountType   String?
  increaseAmount       Decimal?         @db.Decimal(12, 2)
  maxCap               Decimal?         @db.Decimal(12, 2)
  buyFee               Decimal?         @db.Decimal(12, 2)
  lateFeePerDay        Decimal?         @db.Decimal(12, 2)
  lateFeeAfterDays     Int?
  gracePeriodDays      Int?
  isActive             Boolean          @default(true)
  /** Full dealer UI flooring config (tiers, payoffDays, applied, scope). */
  configJson           Json?
  createdById          String?          @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  vehicles Vehicle[]

  @@index([dealershipId, isActive])
  @@map("flooring_plans")
}

/** One 3-hour undo snapshot per dealership after flooring is removed from all vehicles. */
model FlooringUndoSnapshot {
  id           String     @id @default(uuid()) @db.Uuid
  dealershipId String     @unique @db.Uuid
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  snapshot     Json
  createdById  String?    @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([expiresAt])
  @@map("flooring_undo_snapshots")
}

// ??? Customers ????????????????????????????????????????????????????????????????

model Customer {
  id                    String         @id @default(uuid()) @db.Uuid
  dealershipId          String         @db.Uuid
  dealership            Dealership     @relation(fields: [dealershipId], references: [id])
  type                  CustomerType   @default(individual)
  name                  String
  phone                 String?
  email                 String?
  address               String?
  address2              String?
  city                  String?
  state                 String?
  zip                   String?
  driversLicenseNumber  String?
  imageUrl              String?
  status                CustomerStatus @default(lead)
  salesRepId            String?        @db.Uuid
  salesRep              User?          @relation("CustomerSalesRep", fields: [salesRepId], references: [id])
  source                LeadSource?
  dateOfBirth           DateTime?      @db.Date
  notes                 String?
  createdById           String?        @db.Uuid
  createdBy             User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  customerNotes     CustomerNote[]
  customerDocuments CustomerDocument[]
  deals             Deal[]
  dealJackets       DealJacket[]

  @@index([dealershipId, status, deletedAt])
  @@index([dealershipId, email])
  @@index([dealershipId, phone])
  @@map("customers")
}

model CustomerNote {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String     @db.Uuid
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealershipId String     @db.Uuid
  body         String
  createdById  String?    @db.Uuid
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([customerId])
  @@map("customer_notes")
}

model CustomerDocument {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String     @db.Uuid
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealershipId String     @db.Uuid
  label        String
  storagePath  String
  createdById  String?    @db.Uuid
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([customerId])
  @@map("customer_documents")
}

// ??? Deals & Jackets ??????????????????????????????????????????????????????????

model Deal {
  id                   String          @id @default(uuid()) @db.Uuid
  vehicleId            String          @unique @db.Uuid
  vehicle              Vehicle         @relation(fields: [vehicleId], references: [id])
  customerId           String          @db.Uuid
  customer             Customer        @relation(fields: [customerId], references: [id])
  dealershipId         String          @db.Uuid
  dealership           Dealership      @relation(fields: [dealershipId], references: [id])
  saleDate             DateTime        @db.Date
  totalPriceOtd        Decimal         @db.Decimal(12, 2)
  totalCollected       Decimal         @default(0) @db.Decimal(12, 2)
  salesTaxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  licenseFees          Decimal         @default(0) @db.Decimal(12, 2)
  dmvFees              Decimal         @default(0) @db.Decimal(12, 2)
  otherFees            Decimal         @default(0) @db.Decimal(12, 2)
  soldPriceBeforeTax   Decimal?        @db.Decimal(12, 2)
  commissionAmount     Decimal?        @db.Decimal(12, 2)
  commissionRate       Decimal?        @db.Decimal(5, 2)
  commissionType       CommissionType?
  netProfit            Decimal?        @db.Decimal(12, 2)
  salesRepId           String?         @db.Uuid
  salesRep             User?           @relation("DealSalesRep", fields: [salesRepId], references: [id])
  rosNumber            String?
  zipOfSale            String?
  notes                String?
  createdById          String?         @db.Uuid
  createdBy            User?           @relation("DealCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime        @default(now())
  deletedAt            DateTime?

  dealJacket DealJacket?

  @@index([dealershipId, saleDate])
  @@map("deals")
}

model DealJacket {
  id                  String                   @id @default(uuid()) @db.Uuid
  dealershipId        String                   @db.Uuid
  dealership          Dealership               @relation(fields: [dealershipId], references: [id])
  vehicleId           String                   @db.Uuid
  vehicle             Vehicle                  @relation(fields: [vehicleId], references: [id])
  customerId          String                   @db.Uuid
  customer            Customer                 @relation(fields: [customerId], references: [id])
  dealId              String?                  @unique @db.Uuid
  deal                Deal?                    @relation(fields: [dealId], references: [id])
  salesRepId          String?                  @db.Uuid
  salesRep            User?                    @relation("JacketSalesRep", fields: [salesRepId], references: [id])
  jacketNumber        String
  soldPrice           Decimal                  @default(0) @db.Decimal(12, 2)
  totalTax            Decimal                  @default(0) @db.Decimal(12, 2)
  totalSalePrice      Decimal                  @default(0) @db.Decimal(12, 2)
  downPayment         Decimal                  @default(0) @db.Decimal(12, 2)
  amountFinanced      Decimal                  @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal                  @default(0) @db.Decimal(12, 2)
  totalInvested       Decimal                  @default(0) @db.Decimal(12, 2)
  additionalExpenses  Decimal                  @default(0) @db.Decimal(12, 2)
  commissionAmount    Decimal                  @default(0) @db.Decimal(12, 2)
  profitGross         Decimal                  @default(0) @db.Decimal(12, 2)
  profitNet           Decimal                  @default(0) @db.Decimal(12, 2)
  tradeInAllowance    Decimal                  @default(0) @db.Decimal(12, 2)
  warrantyAmount      Decimal                  @default(0) @db.Decimal(12, 2)
  gapAmount           Decimal                  @default(0) @db.Decimal(12, 2)
  fees                Json                     @default("{}")
  lender              String?
  rosNumber           String?
  notes               String?
  reviewNotes         String?
  rejectionReason     String?
  dealType            DealType                 @default(Retail)
  workflowStatus      DealJacketWorkflowStatus @default(draft)
  dateSold            DateTime?
  reviewedAt          DateTime?
  reviewedById        String?                  @db.Uuid
  reviewedBy          User?                    @relation("JacketReviewedBy", fields: [reviewedById], references: [id])
  createdById         String?                  @db.Uuid
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  documents      DealJacketDocument[]
  activity       DealJacketActivity[]
  commission     SalesRepCommission?
  filingPeriodDeals FilingPeriodDeal[]

  @@index([dealershipId, workflowStatus])
  @@index([dealershipId, jacketNumber])
  @@map("deal_jackets")
}

model DealJacketDocument {
  id           String     @id @default(uuid()) @db.Uuid
  dealJacketId String     @db.Uuid
  dealJacket   DealJacket @relation(fields: [dealJacketId], references: [id], onDelete: Cascade)
  fileUrl      String
  documentName String
  fileType     String     @default("application/pdf")
  uploadedAt   DateTime   @default(now())

