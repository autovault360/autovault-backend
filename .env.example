PORT=3000
NODE_ENV=development

# Neon PostgreSQL (required)
# App / pooled connection (host contains -pooler):
# postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL=
# Direct connection for migrations (same host WITHOUT -pooler):
# postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_SECRET=change-me-min-16-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_URL=http://localhost:5500
OWNER_API_KEY=change-me-owner-api-key

# Platform owner seed (created on boot if set)
SUPER_OWNER_EMAIL=owner@autovault360.com
SUPER_OWNER_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WHOLESALER_PRICE_ID=price_...
STRIPE_INDEPENDENT_DEALER_PRICE_ID=price_...
STRIPE_GROWING_DEALERSHIP_PRICE_ID=price_...

# Email (Brevo)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=onboarding@noumandevs.online
BREVO_SENDER_NAME=AutoVault

# Redis — prefer local/VPS Redis (recommended on VPS)
REDIS_URL=redis://127.0.0.1:6379
# Optional password: redis://:YOUR_PASSWORD@127.0.0.1:6379

# Or Upstash Redis (REST) — used only when REDIS_URL is empty
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 (file uploads)
# Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autovault
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
# Public base URL (r2.dev or custom domain), e.g. https://pub-xxxxx.r2.dev
R2_PUBLIC_BASE_URL=

# Jenna AI (OpenRouter) — 5 vars only
OPENROUTER_API_KEY=
JENNA_ENABLED=false
JENNA_MODEL_CHAT=openrouter/free
JENNA_MODEL_EMBED=openai/text-embedding-3-small
JENNA_DAILY_LIMIT=20

# Supabase (social automation)
SUPABASE_URL=
SUPABASE_KEY=

# X (Twitter) API v2 Credentials
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://autovault360.com/api/owner/socials/x/callback



