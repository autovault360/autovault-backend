{
  "name": "autovault-backend",
  "version": "2.0.0",
  "description": "AutoVault multi-tenant CRM API (Express + Prisma + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed:cpa": "node prisma/seed-cpa.js",
    "db:seed:vehicles": "node prisma/seed-vehicles.js",
    "db:seed:wholesale": "node prisma/seed-wholesale.js",
    "db:create-user": "node prisma/create-user.js",
    "db:delete-user": "node prisma/delete-user.js",
    "r2:cors": "node scripts/configure-r2-cors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:logins": "vitest run tests/integration/logins.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@getbrevo/brevo": "^6.0.2",
    "@prisma/client": "^6.16.0",
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "stripe": "^16.8.0",
    "twitter-api-v2": "^1.29.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.16.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
